<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User</title>
</head>
<body>

    <h1>User page</h1>

    <% if(user){ %>
        <% if(user.role==="amdin") %>
            <h1><%= user.name %></h1>
            <h1><%= user.role %></h1>
            <h1><%= user.id %></h1>
    <%} else {%>

            <h1>No user data available</h1>
    <% }%>
</body>
</html>