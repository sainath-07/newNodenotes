<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Users page</h1>

    <% if(output && output.length>0) { %>
        <ul>
            <% output.forEach((item)=>{ %>
                <li><%= item.id %></li>
                <li><%= item.name %></li>
                <li><%= item.email %></li>
                <br><br>
            <%})%>
        </ul>

    <%} else {%>
        <p>No users Found</p>
    <%}%>
</body>
</html>